{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "VideoForge",
  "outputfilename": "VideoForge",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "postBuildHooks": {
    "darwin/arm64": "bash ../../scripts/bundle-ffmpeg.sh darwin",
    "darwin/amd64": "bash ../../scripts/bundle-ffmpeg.sh darwin",
    "darwin/universal": "bash ../../scripts/bundle-ffmpeg.sh darwin"
  },
  "author": {
    "name": "Ayman Hamdoun",
    "email": "ayman.s.hamdoun@gmail.com"
  }
}
